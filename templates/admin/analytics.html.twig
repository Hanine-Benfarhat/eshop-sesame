{% extends 'admin/base.html.twig' %}

{% block title %}Analytics - Admin{% endblock %}
{% block page_title %}Analytics & Reports{% endblock %}
{% block page_subtitle %}Marketplace performance overview and insights{% endblock %}

{% block body %}
<!-- Overview Stats -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stats-card">
            <div class="stats-card-icon" style="background: #dbeafe;">
                <i class="bi bi-people" style="color: #3b82f6;"></i>
            </div>
            <h2 class="stats-card-value" style="color: #3b82f6;">{{ totalUsers }}</h2>
            <p class="stats-card-label">Total Users</p>
            <small class="text-muted">
                <i class="bi bi-arrow-up text-success"></i> {{ usersThisWeek }} this week
            </small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card">
            <div class="stats-card-icon" style="background: #d1fae5;">
                <i class="bi bi-box-seam" style="color: #10b981;"></i>
            </div>
            <h2 class="stats-card-value" style="color: #10b981;">{{ totalProducts }}</h2>
            <p class="stats-card-label">Total Products</p>
            <small class="text-muted">
                <i class="bi bi-arrow-up text-success"></i> {{ productsThisWeek }} this week
            </small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card">
            <div class="stats-card-icon" style="background: #fef3c7;">
                <i class="bi bi-person-plus" style="color: #f59e0b;"></i>
            </div>
            <h2 class="stats-card-value" style="color: #f59e0b;">{{ usersThisMonth }}</h2>
            <p class="stats-card-label">New Users (30 days)</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card">
            <div class="stats-card-icon" style="background: #e0e7ff;">
                <i class="bi bi-cart-plus" style="color: #6366f1;"></i>
            </div>
            <h2 class="stats-card-value" style="color: #6366f1;">{{ productsThisMonth }}</h2>
            <p class="stats-card-label">New Products (30 days)</p>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Product Status Breakdown -->
    <div class="col-md-6">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5 class="admin-card-title mb-0">
                    <i class="bi bi-pie-chart me-2"></i>Product Status Breakdown
                </h5>
            </div>
            <div class="admin-card-body">
                {% set total = approvedCount + pendingCount + rejectedCount %}
                
                {% if total > 0 %}
                    <div class="mb-4">
                        <div class="d-flex justify-content-between mb-1">
                            <span><i class="bi bi-circle-fill text-success me-1"></i> Approved</span>
                            <strong>{{ approvedCount }} ({{ ((approvedCount / total) * 100)|round(1) }}%)</strong>
                        </div>
                        <div class="progress mb-3" style="height: 10px;">
                            <div class="progress-bar bg-success" style="width: {{ (approvedCount / total) * 100 }}%"></div>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <div class="d-flex justify-content-between mb-1">
                            <span><i class="bi bi-circle-fill text-warning me-1"></i> Pending</span>
                            <strong>{{ pendingCount }} ({{ ((pendingCount / total) * 100)|round(1) }}%)</strong>
                        </div>
                        <div class="progress mb-3" style="height: 10px;">
                            <div class="progress-bar bg-warning" style="width: {{ (pendingCount / total) * 100 }}%"></div>
                        </div>
                    </div>
                    
                    <div class="mb-2">
                        <div class="d-flex justify-content-between mb-1">
                            <span><i class="bi bi-circle-fill text-danger me-1"></i> Rejected</span>
                            <strong>{{ rejectedCount }} ({{ ((rejectedCount / total) * 100)|round(1) }}%)</strong>
                        </div>
                        <div class="progress mb-3" style="height: 10px;">
                            <div class="progress-bar bg-danger" style="width: {{ (rejectedCount / total) * 100 }}%"></div>
                        </div>
                    </div>

                    <hr>
                    <div class="d-flex justify-content-between">
                        <span class="fw-bold">Total Products</span>
                        <strong>{{ total }}</strong>
                    </div>
                {% else %}
                    <div class="empty-state">
                        <i class="bi bi-inbox"></i>
                        <p class="text-muted mb-0">No products yet</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Category Distribution -->
    <div class="col-md-6">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5 class="admin-card-title mb-0">
                    <i class="bi bi-tags me-2"></i>Products by Category
                </h5>
            </div>
            <div class="admin-card-body">
                {% if categoryStats|length > 0 %}
                    {% set maxCount = categoryStats|first.count %}
                    {% set colors = ['#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#6366f1', '#ec4899', '#14b8a6', '#f97316'] %}
                    {% for stat in categoryStats %}
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span>
                                    <i class="bi bi-tag-fill me-1" style="color: {{ colors[loop.index0 % colors|length] }}"></i>
                                    {{ stat.category ?? 'Uncategorized' }}
                                </span>
                                <strong>{{ stat.count }} {{ stat.count == 1 ? 'product' : 'products' }}</strong>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar" 
                                     style="width: {{ (stat.count / maxCount) * 100 }}%; background: {{ colors[loop.index0 % colors|length] }}">
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="empty-state">
                        <i class="bi bi-tags"></i>
                        <p class="text-muted mb-0">No category data available</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Top Sellers -->
    <div class="col-md-6">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5 class="admin-card-title mb-0">
                    <i class="bi bi-trophy me-2"></i>Top Sellers
                </h5>
            </div>
            <div class="admin-card-body p-0">
                {% if topSellers|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-modern mb-0">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Seller</th>
                                    <th>Products</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in topSellers %}
                                    {% set seller = item[0] %}
                                    {% set count = item.productCount %}
                                    {% if count > 0 %}
                                    <tr>
                                        <td>
                                            {% if loop.index <= 3 %}
                                                <span class="badge bg-{{ loop.index == 1 ? 'warning' : (loop.index == 2 ? 'secondary' : 'info') }}">
                                                    <i class="bi bi-trophy"></i> {{ loop.index }}
                                                </span>
                                            {% else %}
                                                <span class="badge bg-light text-dark">{{ loop.index }}</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="user-avatar me-2" style="width:32px;height:32px;font-size:12px;">
                                                    {{ seller.email|slice(0, 2)|upper }}
                                                </div>
                                                <div>
                                                    <strong>{{ seller.firstName ?? seller.email }}</strong>
                                                    <br>
                                                    <small class="text-muted">{{ seller.email }}</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-success">{{ count }} products</span>
                                        </td>
                                    </tr>
                                    {% endif %}
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="empty-state">
                        <i class="bi bi-trophy"></i>
                        <p class="text-muted mb-0">No sellers yet</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Quick Stats Summary -->
    <div class="col-md-6">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5 class="admin-card-title mb-0">
                    <i class="bi bi-lightning me-2"></i>Quick Summary
                </h5>
            </div>
            <div class="admin-card-body">
                <div class="row g-3">
                    <div class="col-6">
                        <div class="p-3 rounded" style="background: #f0fdf4; border: 1px solid #bbf7d0;">
                            <div class="text-center">
                                <i class="bi bi-check-circle text-success fs-3"></i>
                                <h4 class="mb-0 mt-2 text-success">{{ approvedCount }}</h4>
                                <small class="text-muted">Approved</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded" style="background: #fefce8; border: 1px solid #fde68a;">
                            <div class="text-center">
                                <i class="bi bi-clock text-warning fs-3"></i>
                                <h4 class="mb-0 mt-2 text-warning">{{ pendingCount }}</h4>
                                <small class="text-muted">Pending</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded" style="background: #fef2f2; border: 1px solid #fecaca;">
                            <div class="text-center">
                                <i class="bi bi-x-circle text-danger fs-3"></i>
                                <h4 class="mb-0 mt-2 text-danger">{{ rejectedCount }}</h4>
                                <small class="text-muted">Rejected</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded" style="background: #eff6ff; border: 1px solid #bfdbfe;">
                            <div class="text-center">
                                <i class="bi bi-people text-primary fs-3"></i>
                                <h4 class="mb-0 mt-2 text-primary">{{ totalUsers }}</h4>
                                <small class="text-muted">Users</small>
                            </div>
                        </div>
                    </div>
                </div>

                {% if pendingCount > 0 %}
                    <div class="alert alert-warning mt-3 mb-0">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong>{{ pendingCount }} products</strong> are waiting for your review.
                        <a href="{{ path('admin_products', {filter: 'pending'}) }}" class="alert-link">Review now →</a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<!-- Recent Activity -->
<div class="row g-4">
    <!-- Recent Products -->
    <div class="col-md-6">
        <div class="admin-card">
            <div class="admin-card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="admin-card-title mb-0">
                        <i class="bi bi-clock-history me-2"></i>Recent Products
                    </h5>
                    <a href="{{ path('admin_products') }}" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
            </div>
            <div class="admin-card-body p-0">
                {% if recentProducts|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-modern mb-0">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Price</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for product in recentProducts %}
                                    <tr>
                                        <td>
                                            <strong>{{ product.name }}</strong>
                                            <br>
                                            <small class="text-muted">{{ product.category }}</small>
                                        </td>
                                        <td><strong class="text-primary">${{ product.price|number_format(2) }}</strong></td>
                                        <td>
                                            <span class="status-badge status-{{ product.status }}">
                                                {{ product.status }}
                                            </span>
                                        </td>
                                        <td>
                                            <small class="text-muted">{{ product.createdAt|date('M d, Y') }}</small>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="empty-state">
                        <i class="bi bi-inbox"></i>
                        <p class="text-muted mb-0">No products yet</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Recent Users -->
    <div class="col-md-6">
        <div class="admin-card">
            <div class="admin-card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="admin-card-title mb-0">
                        <i class="bi bi-person-plus me-2"></i>Recent Users
                    </h5>
                    <a href="{{ path('admin_users') }}" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
            </div>
            <div class="admin-card-body p-0">
                {% if recentUsers|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-modern mb-0">
                            <thead>
                                <tr>
                                    <th>User</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th>Joined</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for user in recentUsers %}
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="user-avatar me-2" style="width:32px;height:32px;font-size:12px;">
                                                    {{ user.email|slice(0, 2)|upper }}
                                                </div>
                                                <strong>{{ user.firstName ?? 'N/A' }} {{ user.lastName ?? '' }}</strong>
                                            </div>
                                        </td>
                                        <td><small>{{ user.email }}</small></td>
                                        <td>
                                            {% if 'ROLE_ADMIN' in user.roles %}
                                                <span class="badge bg-danger">Admin</span>
                                            {% else %}
                                                <span class="badge bg-primary">User</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <small class="text-muted">
                                                {{ user.createdAt ? user.createdAt|date('M d, Y') : 'Unknown' }}
                                            </small>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="empty-state">
                        <i class="bi bi-people"></i>
                        <p class="text-muted mb-0">No users yet</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<style>
.user-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 14px;
}
</style>
{% endblock %}