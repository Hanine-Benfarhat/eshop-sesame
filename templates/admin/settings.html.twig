{% extends 'admin/base.html.twig' %}

{% block title %}Settings - Admin{% endblock %}
{% block page_title %}Settings{% endblock %}
{% block page_subtitle %}Configure your marketplace settings{% endblock %}

{% block body %}
<div class="row g-4">
    <!-- Site Settings -->
    <div class="col-md-6">
        <div class="admin-card">
            <div class="admin-card-header" style="background: linear-gradient(135deg, #3b82f6, #2563eb); border: none;">
                <h5 class="admin-card-title mb-0" style="color: white;">
                    <i class="bi bi-gear me-2"></i>Site Settings
                </h5>
            </div>
            <div class="admin-card-body">
                <form>
                    <div class="mb-3">
                        <label for="siteName" class="form-label fw-bold">Site Name</label>
                        <input type="text" class="form-control" id="siteName" value="Sesame Marketplace" disabled>
                        <small class="text-muted">Update this in config/services.yaml</small>
                    </div>
                    <div class="mb-3">
                        <label for="siteEmail" class="form-label fw-bold">Contact Email</label>
                        <input type="email" class="form-control" id="siteEmail" value="admin@sesame.com" disabled>
                        <small class="text-muted">Configure in environment variables</small>
                    </div>
                    <div class="mb-3">
                        <label for="maintenanceMode" class="form-label fw-bold">Maintenance Mode</label>
                        <select class="form-select" id="maintenanceMode" disabled>
                            <option selected>Disabled</option>
                            <option>Enabled</option>
                        </select>
                        <small class="text-muted">Feature coming soon</small>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Product Approval Settings -->
    <div class="col-md-6">
        <div class="admin-card">
            <div class="admin-card-header" style="background: linear-gradient(135deg, #10b981, #059669); border: none;">
                <h5 class="admin-card-title mb-0" style="color: white;">
                    <i class="bi bi-box-seam me-2"></i>Product Settings
                </h5>
            </div>
            <div class="admin-card-body">
                <form>
                    <div class="mb-3">
                        <label for="autoApprove" class="form-label fw-bold">Auto-Approve Products</label>
                        <select class="form-select" id="autoApprove" disabled>
                            <option selected>Manual Approval Required</option>
                            <option>Auto-Approve All</option>
                        </select>
                        <small class="text-muted">Feature coming soon</small>
                    </div>
                    <div class="mb-3">
                        <label for="maxPrice" class="form-label fw-bold">Maximum Product Price ($)</label>
                        <input type="number" class="form-control" id="maxPrice" value="10000" disabled>
                        <small class="text-muted">Configure validation in ProductType form</small>
                    </div>
                    <div class="mb-3">
                        <label for="maxImageSize" class="form-label fw-bold">Max Image Size (MB)</label>
                        <input type="number" class="form-control" id="maxImageSize" value="5" disabled>
                        <small class="text-muted">Configure in config/services.yaml</small>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Security Settings -->
    <div class="col-md-6">
        <div class="admin-card">
            <div class="admin-card-header" style="background: linear-gradient(135deg, #ef4444, #dc2626); border: none;">
                <h5 class="admin-card-title mb-0" style="color: white;">
                    <i class="bi bi-shield-lock me-2"></i>Security Settings
                </h5>
            </div>
            <div class="admin-card-body">
                <form>
                    <div class="mb-3">
                        <label for="sessionTimeout" class="form-label fw-bold">Session Timeout (minutes)</label>
                        <input type="number" class="form-control" id="sessionTimeout" value="30" disabled>
                        <small class="text-muted">Configure in config/packages/framework.yaml</small>
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="require2FA" disabled>
                            <label class="form-check-label" for="require2FA">
                                Require Two-Factor Authentication
                            </label>
                        </div>
                        <small class="text-muted">Feature coming soon</small>
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="enableRecaptcha" disabled>
                            <label class="form-check-label" for="enableRecaptcha">
                                Enable reCAPTCHA
                            </label>
                        </div>
                        <small class="text-muted">Feature coming soon</small>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Email Settings -->
    <div class="col-md-6">
        <div class="admin-card">
            <div class="admin-card-header" style="background: linear-gradient(135deg, #6366f1, #4f46e5); border: none;">
                <h5 class="admin-card-title mb-0" style="color: white;">
                    <i class="bi bi-envelope me-2"></i>Email Settings
                </h5>
            </div>
            <div class="admin-card-body">
                <form>
                    <div class="mb-3">
                        <label for="smtpServer" class="form-label fw-bold">SMTP Server</label>
                        <input type="text" class="form-control" id="smtpServer" value="smtp.mailtrap.io" disabled>
                        <small class="text-muted">Configure in .env file (MAILER_DSN)</small>
                    </div>
                    <div class="mb-3">
                        <label for="fromEmail" class="form-label fw-bold">From Email</label>
                        <input type="email" class="form-control" id="fromEmail" value="noreply@sesame.com" disabled>
                        <small class="text-muted">Configure in config/packages/mailer.yaml</small>
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="emailNotifications" checked disabled>
                            <label class="form-check-label" for="emailNotifications">
                                Email Notifications Enabled
                            </label>
                        </div>
                        <small class="text-muted">Feature coming soon</small>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="alert alert-info mt-4" style="border-radius: 0.75rem; border: none; border-left: 4px solid #3b82f6;">
    <i class="bi bi-info-circle me-2"></i>
    <strong>Note:</strong> Most settings are currently managed through configuration files and environment variables.
    Dynamic settings management will be implemented in future updates.
</div>
{% endblock %}
