{% extends 'base.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row g-4">
        <!-- Product Image -->
        <div class="col-md-5">
            {% if product.image %}
                <div class="card border-0 shadow-sm">
                    <img src="{{ asset('uploads/products/' ~ product.image) }}" 
                         alt="{{ product.name }}" 
                         class="card-img-top rounded-4" 
                         style="width:100%; object-fit: cover; max-height:400px;">
                </div>
            {% else %}
                <div class="card border-0 shadow-sm bg-light d-flex align-items-center justify-content-center rounded-4" 
                     style="height:400px;">
                    <span class="text-muted">No Image</span>
                </div>
            {% endif %}
        </div>

        <!-- Product Details -->
        <div class="col-md-7 d-flex flex-column justify-content-between">
            <div>
                <h2 class="fw-bold">{{ product.name }}</h2>
                <p class="text-muted mb-2">{{ product.category ?: 'Uncategorized' }}</p>
                <h4 class="text-primary fw-bold mb-3">${{ product.price|number_format(2, '.', ',') }}</h4>
                <p class="mb-3">{{ product.description }}</p>
                <p><strong>Available Quantity:</strong> {{ product.quantity }}</p>
                <p><small class="text-muted">Added on: {{ product.createdAt ? product.createdAt|date('Y-m-d H:i') : '' }}</small></p>
            </div>

            <div class="mt-4">
                <a href="#" class="btn btn-lg btn-primary w-100">Buy Now</a>

            </div>
        </div>
    </div>
</div>

<style>
.card-img-top {
    border-radius: 1rem 1rem 1rem 1rem;
}

h2 {
    font-size: 2rem;
}

p {
    line-height: 1.6;
}

.btn-primary {
    font-weight: 600;
    padding: 0.75rem 1rem;
    font-size: 1.1rem;
}

.btn-outline-secondary, .btn-outline-warning {
    font-size: 0.9rem;
}
</style>
{% endblock %}
