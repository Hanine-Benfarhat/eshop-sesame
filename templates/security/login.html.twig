{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h3 class="text-center">Connexion - Gestion de Produits</h3>
                </div>
                <div class="card-body">
                    {% if error %}
                        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                    {% endif %}

                    <form method="post">
                        <div class="form-group mb-3">
                            <label for="inputEmail">Email</label>
                            <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus>
                        </div>

                        <div class="form-group mb-3">
                            <label for="inputPassword">Mot de passe</label>
                            <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <div class="form-group mb-3">
                            <div class="form-check">
                                <input type="checkbox" name="_remember_me" id="remember_me" class="form-check-input">
                                <label class="form-check-label" for="remember_me">Se souvenir de moi</label>
                            </div>
                        </div>

                        <button class="btn btn-primary btn-block w-100" type="submit">Se connecter</button>
                    </form>

                    <div class="text-center mt-3">
                        <small>Pas de compte ? <a href="{{ path('app_register') }}">S'inscrire</a></small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
